# =============================================================================
# GPMorgan Forge: Environment Configuration Template (.env.example)
# Copy this file to .env for local overrides: cp .env.example .env
# Never commit .env containing production secrets to version control.
# =============================================================================

# --- Runtime & OpenTelemetry Observability ---
# Limit concurrent image pulls to 1 so multi-GB Lakehouse pulls do not exceed
# Docker Hub's 300-second OAuth2 Bearer token TTL while queued.
COMPOSE_PARALLEL_LIMIT=1
FORGE_ENV=verification
OTEL_SERVICE_NAME=gpmorgan-forge-core
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317

# --- Portfolio 1, 2, 3, 5: PostgreSQL 18 Primary Node (OLTP Core & Shards) ---
POSTGRES_DB=gpmorgan_forge
POSTGRES_USER=forge_admin
POSTGRES_PASSWORD=forge_secure_pass_2026
POSTGRES_PORT=5432

# --- Portfolio 5: PostgreSQL 18 Read Replica Node (Analytical Offload & HA) ---
POSTGRES_REPLICA_USER=forge_readonly
POSTGRES_REPLICA_PASSWORD=forge_replica_pass_2026
REPLICATION_PASSWORD=forge_repl_pass_2026
POSTGRES_REPLICA_PORT=5433

# --- Portfolio 5: CockroachDB Multi-Region Active-Active SQL (Raft SERIALIZABLE) ---
COCKROACH_SQL_PORT=26257
COCKROACH_HTTP_PORT=8080

# --- Portfolio 4: MongoDB 8.0 LTS Document Store (KYC & Device Telemetry) ---
MONGO_DB=gpmorgan_forge_docs
MONGO_USER=forge_mongo_admin
MONGO_PASSWORD=forge_mongo_pass_2026
MONGO_PORT=27017
KMS_MASTER_KEY_ID=kms-ng-cbn-key-2026-01

# --- Portfolio 4: Neo4j 5.26 LTS Property Graph (AML Fraud Ring Detection) ---
NEO4J_USER=neo4j
NEO4J_PASSWORD=forge_graph_pass_2026
NEO4J_AUTH=neo4j/forge_graph_pass_2026
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# --- Portfolio 4 & 5: Redis 8.0 / Valkey (Two-Tier Idempotency & Rate Limit) ---
REDIS_PORT=6379
REDIS_DB=0

# --- Portfolio 4: Apache Cassandra 5.0 (Read-Only CDC Timeline Projections) ---
CASSANDRA_HOST=cassandra
CASSANDRA_CLUSTER_NAME=gpmorgan_forge_ring
CASSANDRA_DC=dc_lagos_ng
CASSANDRA_CQL_PORT=9042

# --- Portfolio 4 & 5: TimescaleDB Hypertables (High-Frequency FX Tick Telemetry) ---
TIMESCALE_DB=gpmorgan_forge_tsdb
TIMESCALE_USER=forge_ts_admin
TIMESCALE_PASSWORD=forge_ts_pass_2026
TIMESCALE_PORT=5434

# --- Portfolio 5: Apache Kafka 4.0 (KRaft) & Apache Flink Stream Processor ---
KAFKA_PORT=9092
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
FLINK_UI_PORT=8081
FLINK_REST_URI=http://flink:8081

# --- Portfolio 5: Open Table Medallion Lakehouse (Apache Iceberg + Polaris + Trino) ---
POLARIS_PORT=8181
POLARIS_CATALOG_URI=http://polaris-catalog:8181/api/catalog
POLARIS_DEFAULT_BRANCH=main
TRINO_PORT=8082
TRINO_COORDINATOR_URI=http://trino:8080

# --- Lakehouse orchestration, CDC & catalog credentials (Portfolio 5) ---
DEBEZIUM_PORT=8083
AIRFLOW_PORT=8085
POLARIS_OAUTH_CREDENTIAL=root:s3cr3t
AWS_REGION=eu-west-1
